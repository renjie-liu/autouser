# AutoUser environment template.
# Copy to .env (gitignored) and fill in. You only need a key for the provider
# you actually use — the claude_code provider needs no key at all.

# Anthropic — default provider (model defaults to claude-sonnet-4-6).
ANTHROPIC_API_KEY=

# Google Gemini — alternative provider.
GEMINI_API_KEY=

# --- Optional knobs (uncomment to override defaults) ---

# Force a provider regardless of which keys are present:
#   anthropic | gemini | claude_code
# AUTOUSER_PROVIDER=anthropic

# Point Playwright at a pre-installed Chromium if `playwright install` is
# blocked by network policy (see README "Setup").
# AUTOUSER_BROWSER_EXECUTABLE=/path/to/chrome

# claude_code provider tuning (uses the local `claude` CLI; no API key needed):
# AUTOUSER_CLAUDE_CODE_MAX_SPAWNS=1   # process-global concurrency cap
# AUTOUSER_CLAUDE_CODE_TIMEOUT=120    # per-call timeout, seconds
